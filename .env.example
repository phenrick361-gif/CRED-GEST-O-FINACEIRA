NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave anon pública (NUNCA usar service_role no frontend!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# URL base do site (usada nos redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave service_role (usada APENAS em API routes server-side).
# Necessária para criar usuários sem confirmação de e-mail.
# Copie de: Supabase Dashboard > Settings > API > service_role key
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# TEMPORÁRIO: exige confirmação de e-mail no cadastro?
# false (padrão): cria o usuário já confirmado → login imediato, nenhum e-mail é enviado.
# true: envia e-mail de confirmação (requer SMTP configurado no Supabase).
# REQUIRE_EMAIL_CONFIRMATION=false
